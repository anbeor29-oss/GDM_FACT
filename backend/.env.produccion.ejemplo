# ─────────────────────────────────────────────────────────────────────────────
# .env de PRODUCCIÓN — GDM Facturación
#
# Renombra este archivo a  .env  (sin extensión) dentro de la carpeta backend/
# y llena los valores. El servidor lo lee al arrancar.
#
# IMPORTANTE: si el hosting tiene panel de variables de entorno, lo que esté
# ahí GANA sobre este archivo. Es a propósito: el panel es más difícil de
# filtrar por accidente que un archivo dentro de un .zip.
#
# NO subas este archivo a git con valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://usuario:contraseña@host:5432/basededatos

# ── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Seguridad ────────────────────────────────────────────────────────────────
# Cadena larga y aleatoria. Si cambia, todas las sesiones se cierran.
JWT_SECRET=

# ── PAC — TIMBRADO REAL ──────────────────────────────────────────────────────
# LAS TRES son necesarias. Si falta cualquiera, el sistema arranca en modo
# SIMULACIÓN: las facturas salen sin validez fiscal y los complementos de pago
# y notas de crédito se rechazan a propósito para no ensuciar la base.
#
# Al arrancar, el log dice cuál quedó activo:
#   [arranque] PAC: SW_SAPIEN (production) — timbrado REAL
#   [arranque] PAC: MOCK — timbrado SIMULADO
PAC_PROVIDER=SW_SAPIEN
SW_SAPIEN_ENV=production
SW_SAPIEN_TOKEN=

# ── Banco de México (tipos de cambio diarios) ────────────────────────────────
BANXICO_TOKEN=
